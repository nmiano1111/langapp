{"de":[{"partOfSpeech":"Adjective","language":"German","definitions":[{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/quick\" title=\"quick\">quick</a>, <a rel=\"mw:WikiLink\" href=\"/wiki/fast\" title=\"fast\">fast</a>","parsedExamples":[{"example":"Er fährt ein <b>schnelles</b> Auto.","translation":"He is driving a fast car."},{"example":"Ich brauche eine <b>schnelle</b> Antwort.","translation":"I need a quick answer."}],"examples":["Er fährt ein <b>schnelles</b> Auto.","Ich brauche eine <b>schnelle</b> Antwort."]}]},{"partOfSpeech":"Adverb","language":"German","definitions":[{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/quickly\" title=\"quickly\">quickly</a>"},{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/again\" title=\"again\">again</a>; <a rel=\"mw:WikiLink\" href=\"/wiki/quick\" title=\"quick\">quick</a>; <span class=\"use-with-mention\" about=\"#mwt28\" typeof=\"mw:Transclusion\">used after a question to imply that one ought to know the answer</span>","parsedExamples":[{"example":"Wie heißt er <b>schnell</b><span typeof=\"mw:Entity\">?</span>","translation":"What’s his name <b>again</b>?"}],"examples":["Wie heißt er <b>schnell</b><span typeof=\"mw:Entity\">?</span>"]}]}],"other":[{"partOfSpeech":"Adjective","language":"Hunsrik","definitions":[{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/fast\" title=\"fast\">fast</a>, <a rel=\"mw:WikiLink\" href=\"/wiki/quick\" title=\"quick\">quick</a>, <a rel=\"mw:WikiLink\" href=\"/wiki/swift\" title=\"swift\">swift</a>"}]}],"lb":[{"partOfSpeech":"Adjective","language":"Luxembourgish","definitions":[{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/fast\" title=\"fast\">fast</a>, <a rel=\"mw:WikiLink\" href=\"/wiki/quick\" title=\"quick\">quick</a>, <a rel=\"mw:WikiLink\" href=\"/wiki/swift\" title=\"swift\">swift</a>"}]}]}